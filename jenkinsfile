pipeline {
    agent any
    tools { nodejs "nodejs" }

    stages {
        stage('Clonar Repositório') {
            steps {
                bat 'if exist cypress-hub-de-leitura rmdir /s /q cypress-hub-de-leitura'
                bat 'git clone https://github.com/Pesseguini/cypress-hub-de-leitura.git'
            }
        }
        stage('Instalar e Executar') {
            steps {
                dir('cypress-hub-de-leitura') {
                    bat 'npm install'
                    // Sobe o servidor em background real do Windows e já engata o teste
                    bat 'start /b npm start'
                    bat 'npx cypress run'
                }
            }
        }
    }
}
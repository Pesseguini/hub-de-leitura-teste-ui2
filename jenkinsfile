pipeline {
    agent any
    tools { nodejs "nodejs"}

    stages {

        stage('Clonar o hub de Leiura Integrado'){
            steps{
                bat 'git clone' https://github.com/Pesseguini/cypress-hub-de-leitura.git
            }

        }
        stage('Instalar dependências do projeto'){
            steps {
                dir ('cypress-hub-de-leitura') {
                    bat 'npm install'
                    bat 'npm start'
                }
            }

        }
      

    }
    
    }